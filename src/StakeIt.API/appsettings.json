  },
  "AzureStorage": {
    "ConnectionString": "your_azure_storage_connection_string_here",
    "ContainerName": "stakeit-uploads"
  },
  "AppSettings": {
    "PlatformCommissionRate": 0.10,
    "MinimumStakeAmount": 5.00,
